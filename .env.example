# --- Supabase ---
# URL del proyecto (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (Project Settings -> API). Supabase la muestra como
# "Publishable key"; en proyectos antiguos se llama "anon key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave de servicio (service_role). SOLO para el servidor: nunca exponerla en
# el cliente ni con prefijo NEXT_PUBLIC_. Se usa para tareas administrativas
# (p. ej. crear usuarios desde el panel).
SUPABASE_SERVICE_ROLE_KEY=

# --- Tasa de cambio ---
# No se consume ninguna API de tasa. La tasa se ingresa manualmente al registrar
# cada pago en bolívares y se guarda en el pago (ver docs/decisiones.md).
# Por eso no se define BCV_API_URL.
